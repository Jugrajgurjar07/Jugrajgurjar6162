Sub Convert_KrutiDev_To_TimesNewRoman_All()
    Dim i As Integer
    Dim texts As Variant
    Dim replacements As Variant
    Dim findText As String
    Dim replaceText As String

    ' ============================
    ' ?? PART 1: Replace ¼…½ Patterns (case safe)
    ' ============================
    texts = Array( _
        "¼1½", "¼2½", "¼3½", "¼4½", _
        "¼a½", "¼b½", "¼c½", "¼d½", _
        "¼A½", "¼B½", "¼C½", "¼D½", _
        "¼i½", "¼ii½", "¼iii½", "¼iv½", _
        "¼I½", "¼II½", "¼III½", "¼IV½" _
    )

    replacements = Array( _
        "(1)", "(2)", "(3)", "(4)", _
        "(a)", "(b)", "(c)", "(d)", _
        "(A)", "(B)", "(C)", "(D)", _
        "(i)", "(ii)", "(iii)", "(iv)", _
        "(I)", "(II)", "(III)", "(IV)" _
    )

    For i = LBound(texts) To UBound(texts)
        Selection.Find.ClearFormatting
        Selection.Find.Replacement.ClearFormatting

        ' Find only Kruti Dev font text
        Selection.Find.Font.Name = "Kruti Dev 010"

        ' Replace with Times New Roman (11pt)
        With Selection.Find.Replacement.Font
            .Name = "Times New Roman"
            .Size = 11
            .Bold = False
        End With

        With Selection.Find
            .Text = texts(i)
            .Replacement.Text = replacements(i)
            .Forward = True
            .Wrap = wdFindContinue
            .Format = True
            .MatchCase = False ' ? keeps case consistent
            .MatchWholeWord = False
            .MatchWildcards = False
        End With

        Selection.Find.Execute Replace:=wdReplaceAll
    Next i


    ' ============================
    ' ?? PART 2: Replace 1- ? 1. (Bold Numbering)
    ' ============================
    For i = 30 To 1 Step -1
        findText = i & "-"
        replaceText = i & "."

        Selection.Find.ClearFormatting
        Selection.Find.Replacement.ClearFormatting

        Selection.Find.Font.Name = "Kruti Dev 010"

        With Selection.Find.Replacement.Font
            .Name = "Times New Roman"
            .Size = 11
            .Bold = True
        End With

        With Selection.Find
            .Text = findText
            .Replacement.Text = replaceText
            .Forward = True
            .Wrap = wdFindContinue
            .Format = True
            .MatchCase = True
            .MatchWholeWord = False
            .MatchWildcards = False
        End With

        Selection.Find.Execute Replace:=wdReplaceAll
    Next i


    ' ============================
    ' ? DONE
    ' ============================
    MsgBox "? Conversion Complete! (A)/(a) and Roman cases now preserved perfectly.", vbInformation
End Sub

Sub Macro1()
'
' Macro1 Macro
'
'
    With Selection.ParagraphFormat
        .LeftIndent = InchesToPoints(0.5)
        .RightIndent = InchesToPoints(0)
        .SpaceBefore = 0
        .SpaceBeforeAuto = False
        .SpaceAfter = 0
        .SpaceAfterAuto = False
        .LineSpacingRule = wdLineSpaceMultiple
        .LineSpacing = LinesToPoints(1.15)
        .Alignment = wdAlignParagraphLeft
        .KeepWithNext = False
        .KeepTogether = False
        .PageBreakBefore = False
        .NoLineNumber = False
        .Hyphenation = True
        .FirstLineIndent = InchesToPoints(-0.5)
        .OutlineLevel = wdOutlineLevelBodyText
        .CharacterUnitLeftIndent = 0
        .CharacterUnitRightIndent = 0
        .CharacterUnitFirstLineIndent = 0
        .LineUnitBefore = 0
        .LineUnitAfter = 0
        .MirrorIndents = False
        .TextboxTightWrap = wdTightNone
        .CollapsedByDefault = False
    End With
    Selection.ParagraphFormat.TabStops.ClearAll
    ActiveDocument.DefaultTabStop = InchesToPoints(0.5)
    Selection.ParagraphFormat.TabStops.Add Position:=InchesToPoints(0.5), _
        Alignment:=wdAlignTabLeft, Leader:=wdTabLeaderSpaces
    Selection.ParagraphFormat.TabStops.Add Position:=InchesToPoints(0.75), _
        Alignment:=wdAlignTabLeft, Leader:=wdTabLeaderSpaces
    Selection.ParagraphFormat.TabStops.Add Position:=InchesToPoints(2), _
        Alignment:=wdAlignTabLeft, Leader:=wdTabLeaderSpaces
    Selection.ParagraphFormat.TabStops.Add Position:=InchesToPoints(3.5), _
        Alignment:=wdAlignTabLeft, Leader:=wdTabLeaderSpaces
    Selection.ParagraphFormat.TabStops.Add Position:=InchesToPoints(5), _
        Alignment:=wdAlignTabLeft, Leader:=wdTabLeaderSpaces
End Sub
Sub Macro2()
'
' Macro2 Macro
'
'
    Selection.Font.Name = "Signika"
    Selection.Font.Size = 11
End Sub
